; PHASER360 production audio bundle.
; One PnP package for the ADSP audio function and the MAX98357A amplifier.

[Version]
Signature="$WINDOWS NT$"
Class=MEDIA
ClassGuid={4D36E96C-E325-11CE-BFC1-08002BE10318}
Provider=%Provider%
DriverVer=10/07/2026,4.3.0.0
CatalogFile=P360AudioBundle.cat
PnpLockdown=1

[DestinationDirs]
P360_ADSP.CopyFiles=12
P360_AMP.CopyFiles=12
P360_Firmware.CopyFiles=12,P360

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
P360SofAudio.sys=1
P360Max98357Safe.sys=1
sof-apl-v1.9.3-official.ri=1

[Manufacturer]
%Provider%=Models,NTamd64.10.0...19044

[Models.NTamd64.10.0...19044]
%AdspDesc%=P360_ADSP,CSAUDIO\ADSP&CTLR_VEN_8086&CTLR_DEV_3198
%AmpDesc%=P360_AMP,ACPI\MX98357A

[P360_ADSP.NT]
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration,WDMAUDIO.Registration
CopyFiles=P360_ADSP.CopyFiles,P360_Firmware.CopyFiles
AddReg=P360_ADSP.AddReg

[P360_ADSP.CopyFiles]
P360SofAudio.sys

[P360_Firmware.CopyFiles]
sof-apl-v1.9.3-official.ri

[P360_ADSP.AddReg]
HKR,,AssociatedFilters,,"wdmaud"
HKR,,Driver,,P360SofAudio.sys
HKR,Drivers,SubClasses,,"wave,mixer"
HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\wave\wdmaud.drv,Description,,%AdspDesc%
HKR,Drivers\mixer\wdmaud.drv,Description,,%AdspDesc%

[P360_ADSP.NT.Interfaces]
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_WaveSpeaker%,P360.I.WaveSpeaker
AddInterface=%KSCATEGORY_RENDER%,%KSNAME_WaveSpeaker%,P360.I.WaveSpeaker
AddInterface=%KSCATEGORY_REALTIME%,%KSNAME_WaveSpeaker%,P360.I.WaveSpeaker
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_TopologySpeaker%,P360.I.TopologySpeaker
AddInterface=%KSCATEGORY_TOPOLOGY%,%KSNAME_TopologySpeaker%,P360.I.TopologySpeaker

[P360.I.WaveSpeaker]
AddReg=P360.I.WaveSpeaker.AddReg

[P360.I.WaveSpeaker.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%WaveSpeakerName%

[P360.I.TopologySpeaker]
AddReg=P360.I.TopologySpeaker.AddReg

[P360.I.TopologySpeaker.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%TopologySpeakerName%
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_SPEAKER%
HKR,EP\0,%PKEY_AudioEngine_OEMFormat%,%REG_BINARY%,41,00,00,00,28,00,00,00,FE,FF,02,00,80,BB,00,00,00,DC,05,00,08,00,20,00,16,00,10,00,03,00,00,00,01,00,00,00,00,00,10,00,80,00,00,AA,00,38,9B,71

[P360_ADSP.NT.HW]
AddReg=P360_ADSP.HW

[P360_ADSP.HW]
HKR,,DeviceType,0x10001,0x0000001D

[P360_ADSP.NT.Services]
AddService=P360SofAudio,0x00000002,P360_ADSP.Service

[P360_ADSP.Service]
DisplayName=%AdspService%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\P360SofAudio.sys

[P360_ADSP.NT.Wdf]
KmdfService=P360SofAudio,P360_ADSP.Wdf

[P360_ADSP.Wdf]
KmdfLibraryVersion=1.15

[P360_AMP.NT]
CopyFiles=P360_AMP.CopyFiles

[P360_AMP.CopyFiles]
P360Max98357Safe.sys

[P360_AMP.NT.HW]
Include=pci.inf
Needs=PciD3ColdSupported.HW

[P360_AMP.NT.Services]
AddService=P360Max98357Safe,0x00000002,P360_AMP.Service

[P360_AMP.Service]
DisplayName=%AmpService%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\P360Max98357Safe.sys
LoadOrderGroup=Base

[P360_AMP.NT.Wdf]
KmdfService=P360Max98357Safe,P360_AMP.Wdf

[P360_AMP.Wdf]
KmdfLibraryVersion=1.15

[Strings]
Provider="PHASER360 Project"
DiskName="PHASER360 Full Audio Driver"
AdspDesc="PHASER360 Gemini Lake SOF Audio"
AmpDesc="MAX98357A I2S Amplifier (PHASER360)"
AdspService="PHASER360 SOF Audio"
AmpService="PHASER360 MAX98357A Amplifier"

KSNAME_WaveSpeaker="WaveSpeaker"
KSNAME_TopologySpeaker="TopologySpeaker"
WaveSpeakerName="PHASER360 Speakers Wave"
TopologySpeakerName="PHASER360 Speakers Topology"

Proxy.CLSID="{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
KSCATEGORY_AUDIO="{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_RENDER="{65E8773E-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_REALTIME="{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"
KSCATEGORY_TOPOLOGY="{DDA54A40-1E4C-11D1-A050-405705C10000}"
KSNODETYPE_ANY="{00000000-0000-0000-0000-000000000000}"
KSNODETYPE_SPEAKER="{DFF21CE1-F70F-11D0-B917-00A0C9223196}"
PKEY_AudioEndpoint_Association="{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},2"
PKEY_AudioEngine_OEMFormat="{E4870E26-3CC5-4CD2-BA46-CA0A9A70ED04},3"
REG_BINARY=0x00000001
